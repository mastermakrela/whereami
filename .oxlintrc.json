{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"rules": {
		"no-underscore-dangle": ["warn", { "allow": ["__WHEREAMI_PKG__"] }]
	},
	"ignorePatterns": ["dist", "test/fixtures", "*.tsbuildinfo"]
}
